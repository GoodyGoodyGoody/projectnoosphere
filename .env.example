# Project Noosphere — environment variables the app reads. Placeholders only;
# never commit real values. The app does not load a .env file yet: export these
# in your shell, or set them in ecosystem.config.cjs. Phase 4 adds the house
# pattern (instrument.js, --import'ed first, loads a gitignored .env).

# Absolute path to the runtime data directory (SQLite lives here). Production
# sets this in ecosystem.config.cjs; unset → ./data for local development.
SITE_DATA_DIR=

# Loopback bind; nginx is the public edge in production.
HOSTNAME=127.0.0.1
PORT=4400

# SPDX id recorded on every revision (ADR 0004). Leave as CC0-1.0.
NOOSPHERE_CONTENT_LICENSE=CC0-1.0

LOG_LEVEL=info

# Absolute origin for canonical links, sitemap, llms.txt.
PUBLIC_ORIGIN=https://projectnoosphere.org

# Public self-registration: closed unless deliberately opened.
NOOSPHERE_REGISTRATION=closed

# The only peer allowed to set X-Forwarded-For (the local nginx). Leave unset
# when there is no proxy in front.
TRUST_PROXY=127.0.0.1

# Phase 4: SENTRY_DSN=
