# Project Noosphere — environment variables the app reads. Placeholders only;
# never commit real values. The app does not load a .env file yet: export these
# in your shell, or set them in ecosystem.config.cjs. Phase 4 adds the house
# pattern (instrument.js, --import'ed first, loads a gitignored .env).

# Absolute path to the runtime data directory (SQLite lives here). Production
# sets this in ecosystem.config.cjs; unset → ./data for local development.
SITE_DATA_DIR=

# Loopback bind; nginx is the public edge in production.
HOSTNAME=127.0.0.1
PORT=4400

# Recorded on every revision. Pending Randall's licensing decision.
NOOSPHERE_CONTENT_LICENSE=LicenseRef-Noosphere-Pending

LOG_LEVEL=info

# Phase 4: SENTRY_DSN=
